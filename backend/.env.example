# ============================================
# AI Enterprise Hub - Production Environment
# ============================================
# Copy this file to .env and update values

# --- MongoDB Configuration ---
# Production: Use MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- JWT Configuration ---
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your_super_secure_jwt_secret_key_at_least_32_chars
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=7d

# --- Server Configuration ---
PORT=5000
NODE_ENV=production

# --- CORS Configuration ---
# Comma-separated list of allowed origins
CORS_ORIGIN=https://your-frontend-domain.vercel.app,https://your-custom-domain.com

# --- Google Gemini AI ---
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI API ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- File Upload ---
# Max file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads

# --- Logging ---
LOG_LEVEL=error

# --- Security ---
# Set to true in production to enable strict security headers
STRICT_SECURITY=true

# --- Knowledge Base / RAG (Phase 3A) ---
# Max file size for knowledge documents in bytes (default: 20MB)
# KNOWLEDGE_MAX_FILE_SIZE=20971520
# Upload directory for knowledge documents
# KNOWLEDGE_UPLOAD_DIR=uploads/knowledge
# Text chunk size in characters for document splitting
# KNOWLEDGE_CHUNK_SIZE=1000
# Overlap between text chunks
# KNOWLEDGE_CHUNK_OVERLAP=150
# Max candidate embeddings to score per search
# KNOWLEDGE_MAX_CANDIDATES=100
# Minimum cosine similarity score for retrieval results (0-1)
# KNOWLEDGE_MIN_SCORE=0.25
# Max chunks to include in assistant context
# KNOWLEDGE_MAX_CONTEXT_CHUNKS=5
# Max characters for retrieved knowledge context
# KNOWLEDGE_MAX_CONTEXT_LENGTH=4000

# --- Document Intelligence (Phase 3C) ---
# Max file size for document intelligence analysis in bytes (default: 20MB)
# DOCUMENT_MAX_FILE_SIZE=20971520
# Upload directory for document intelligence files
# DOCUMENT_UPLOAD_DIR=uploads/documents
# OCR API URL for external OCR provider (optional, e.g. Tesseract or cloud OCR)
# OCR_API_URL=
# OCR API key for external OCR provider (optional)
# OCR_API_KEY=
# Tesseract CLI path for local OCR (optional, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_PATH=