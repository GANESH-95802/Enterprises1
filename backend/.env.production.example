# ============================================
# AI Enterprise Hub - Production Environment
# ============================================
# Copy to .env for production deployment
# NEVER commit this file to version control

# --- MongoDB ---
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- JWT ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_48_BYTE_BASE64
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=7d

# --- Server ---
PORT=5000
NODE_ENV=production

# --- CORS ---
CORS_ORIGINS=https://your-frontend-domain.com,https://admin.your-frontend-domain.com

# --- AI Providers ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# For key rotation (comma-separated)
# OPENAI_API_KEYS=key1,key2,key3

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- File Uploads ---
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads
KNOWLEDGE_MAX_FILE_SIZE=20971520
KNOWLEDGE_UPLOAD_DIR=uploads/knowledge
DOCUMENT_MAX_FILE_SIZE=20971520
DOCUMENT_UPLOAD_DIR=uploads/documents

# --- RAG / Knowledge Base ---
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_MAX_CANDIDATES=100
KNOWLEDGE_MIN_SCORE=0.25
KNOWLEDGE_MAX_CONTEXT_CHUNKS=5
KNOWLEDGE_MAX_CONTEXT_LENGTH=4000

# --- OCR (Optional) ---
# OCR_API_URL=https://your-ocr-provider.com/api/ocr
# OCR_API_KEY=your_ocr_api_key
# TESSERACT_PATH=/usr/bin/tesseract

# --- Security ---
STRICT_SECURITY=true